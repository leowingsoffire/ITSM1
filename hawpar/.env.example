# ── Haw Par AI Document Intelligence — Environment Template ─────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Analyzer engine: "demo" (offline, no Azure cost) | "azure" (Azure AI Document Intelligence)
ANALYZER_MODE=demo

# ── Azure AI Document Intelligence ─────────────────────────────────────────
# Endpoint of your Document Intelligence (Form Recognizer) resource.
AZURE_DOCINT_ENDPOINT=
# Option A (fastest to demo): resource key.
AZURE_DOCINT_KEY=
# Option B (recommended for production): leave the key blank and use Managed Identity.
# Requires the "Cognitive Services User" role on the resource.
AZURE_DOCINT_USE_MANAGED_IDENTITY=false
# Cost-optimised model. prebuilt-read = cheapest, prebuilt-layout = tables + structure.
AZURE_DOCINT_MODEL_ID=prebuilt-layout
AZURE_DOCINT_API_VERSION=2024-11-30

# ── Application limits ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
MAX_PAGES_PER_DOCUMENT=2000
PIPELINE_CONCURRENCY=3
# Fields below this confidence are routed to the human review queue.
REVIEW_CONFIDENCE_THRESHOLD=0.80

# ── Security ───────────────────────────────────────────────────────────────
# When set, all /api requests must send `x-api-key: <value>`. Blank = open (local demo only).
API_KEY=
# Comma separated list of allowed browser origins. Blank = same-origin only.
CORS_ALLOWED_ORIGINS=
# Per-client request budgets, counted per source IP over a rolling 60s window.
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_UPLOAD_PER_MINUTE=60

# ── Storage ────────────────────────────────────────────────────────────────
# On Azure App Service use /home/data so it survives restarts.
DATA_DIR=./data
